# PingMe backend environment configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/pingme

# API port
PORT=5000

# Meta WhatsApp Cloud API access token
WHATSAPP_TOKEN=your_whatsapp_access_token

# Meta WhatsApp Cloud API phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Verification token used by the Meta webhook handshake (GET /api/webhook)
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Groq API (AI-assisted reminder interpretation for UNKNOWN messages)
# The local .env uses GROQ_API_TOKEN; keep it uncommitted.
GROQ_API_TOKEN=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1